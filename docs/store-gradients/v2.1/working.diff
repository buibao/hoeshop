new file mode 100644
--- /dev/null
+++ b/src/styles/store-gradients.css
@@ -0,0 +1,358 @@
+/* Store Gradient v2.1. One palette, scoped to the shell and labelled portal roots.
+   Colour only: geometry, fonts, motion and business states belong to their owners. */
+.hoe-store-scope {
+  --store-surface-reading: var(--background);
+  --store-surface-input: var(--background);
+  --store-fg: var(--ink);
+  --store-fg-muted: var(--muted);
+  --store-fg-on-action: var(--surface);
+  --store-border-control: var(--muted);
+  --store-tint-cycle: var(--background);
+  --store-shell-logo-end: 14%;
+  --store-shell-blush-position: 34%;
+  --store-header-ivory-position: 58%;
+  --store-footer-warm-position: 64%;
+
+  /* Valid single-colour fallbacks, including browsers without color-mix. */
+  --store-gradient-ambient: linear-gradient(var(--background), var(--background));
+  --store-gradient-header: linear-gradient(90deg, var(--background) var(--store-shell-logo-end), var(--brand-blush) var(--store-shell-blush-position), var(--background) var(--store-header-ivory-position));
+  --store-gradient-footer: linear-gradient(90deg, var(--background) var(--store-shell-logo-end), var(--brand-blush) var(--store-shell-blush-position), var(--background));
+  --store-gradient-form: linear-gradient(var(--background), var(--background));
+  --store-gradient-calendar: linear-gradient(var(--background), var(--background));
+  --store-gradient-submenu-hover: linear-gradient(var(--brand-blush), var(--brand-blush));
+  --store-gradient-blush: linear-gradient(var(--brand-blush), var(--brand-blush));
+  --store-gradient-warm: linear-gradient(var(--background), var(--background));
+  --store-gradient-card: linear-gradient(var(--background), var(--background));
+  --store-gradient-summary: linear-gradient(var(--brand-blush), var(--brand-blush));
+  --store-gradient-selected: linear-gradient(var(--brand-blush), var(--brand-blush));
+  --store-gradient-action: linear-gradient(var(--accent), var(--accent));
+  --store-gradient-action-hover: linear-gradient(var(--accent-hover), var(--accent));
+  --store-gradient-selected-strong: var(--store-gradient-action);
+  color: var(--store-fg);
+}
+
+@supports (color: color-mix(in srgb, white, transparent)) {
+  .hoe-store-scope {
+    /* Ivory at the logo's left endpoint, without a separate tile behind the image. */
+    --store-gradient-header: linear-gradient(90deg, var(--background) var(--store-shell-logo-end),
+      color-mix(in srgb, var(--brand-blush) 62%, var(--background)) var(--store-shell-blush-position),
+      var(--background) var(--store-header-ivory-position),
+      color-mix(in srgb, var(--brand-jasmine) 22%, var(--background)) 100%);
+    --store-gradient-footer: linear-gradient(90deg, var(--background) var(--store-shell-logo-end),
+      color-mix(in srgb, var(--brand-blush) 72%, var(--background)) var(--store-shell-blush-position),
+      color-mix(in srgb, var(--brand-jasmine) 25%, var(--background)) var(--store-footer-warm-position),
+      color-mix(in srgb, var(--brand-caramel) 20%, var(--background)) 100%);
+    --store-gradient-ambient: linear-gradient(110deg, var(--background) 0%,
+      color-mix(in srgb, var(--brand-blush) 65%, var(--background)) 58%,
+      color-mix(in srgb, var(--brand-jasmine) 18%, var(--background)) 100%);
+    --store-gradient-form: linear-gradient(135deg,
+      color-mix(in srgb, var(--brand-blush) 30%, var(--background)) 0%,
+      var(--background) 52%,
+      color-mix(in srgb, var(--brand-jasmine) 12%, var(--background)) 100%);
+    --store-gradient-calendar: linear-gradient(145deg, var(--background),
+      color-mix(in srgb, var(--brand-blush) 20%, var(--background)));
+    --store-gradient-submenu-hover: linear-gradient(110deg,
+      color-mix(in srgb, var(--brand-blush) 78%, var(--background)) 0%,
+      color-mix(in srgb, var(--brand-pink) 16%, var(--background)) 64%,
+      color-mix(in srgb, var(--brand-jasmine) 12%, var(--background)) 100%);
+    --store-gradient-blush: linear-gradient(145deg,
+      color-mix(in srgb, var(--brand-blush) 60%, var(--background)),
+      color-mix(in srgb, var(--brand-pink) 12%, var(--background)));
+    --store-gradient-warm: linear-gradient(135deg, var(--background),
+      color-mix(in srgb, var(--brand-jasmine) 12%, var(--background)) 50%,
+      color-mix(in srgb, var(--brand-caramel) 14%, var(--background)));
+    --store-gradient-card: linear-gradient(145deg, var(--background),
+      color-mix(in srgb, var(--surface-soft) 70%, var(--background)));
+    --store-gradient-summary: linear-gradient(145deg,
+      color-mix(in srgb, var(--brand-blush) 65%, var(--background)),
+      color-mix(in srgb, var(--brand-caramel) 12%, var(--background)));
+    --store-gradient-selected: linear-gradient(135deg,
+      color-mix(in srgb, var(--brand-blush) 80%, var(--background)),
+      color-mix(in srgb, var(--brand-pink) 18%, var(--background)));
+    --store-gradient-action: linear-gradient(120deg, var(--accent),
+      color-mix(in srgb, var(--brand-berry) 45%, var(--accent)));
+    --store-gradient-action-hover: linear-gradient(120deg, var(--accent-hover), var(--accent));
+    --store-border-control: color-mix(in srgb, var(--muted) 80%, var(--background));
+    --store-tint-cycle: color-mix(in srgb, var(--brand-blush) 35%, var(--background));
+  }
+}
+
+/* Reserve the existing 130px logo area in the shell's ivory endpoint on phones. */
+@media (max-width: 767px) {
+  .hoe-store-scope {
+    --store-shell-logo-end: 42%;
+    --store-shell-blush-position: 62%;
+    --store-header-ivory-position: 80%;
+    --store-footer-warm-position: 82%;
+  }
+}
+
+/* Primary actions only. Secondary, text, icon and destructive actions keep rank. */
+.hoe-store-scope :is(.button:not(.secondary), .olf-button) {
+  background-color: var(--accent);
+  background-image: var(--store-gradient-action);
+  color: var(--store-fg-on-action);
+}
+.hoe-store-scope :is(.button:not(.secondary), .olf-button):is(:hover, :active):not(:disabled):not([aria-disabled="true"]) {
+  background-color: var(--accent-hover);
+  background-image: var(--store-gradient-action-hover);
+}
+.hoe-store-scope .button.secondary {
+  background-color: transparent;
+  background-image: none;
+  color: var(--accent);
+}
+.hoe-store-scope .button.secondary:is(:hover, :active):not(:disabled):not([aria-disabled="true"]) {
+  background-color: var(--brand-blush);
+  background-image: var(--store-gradient-selected);
+}
+.hoe-store-scope :is(.button, .olf-button):is(:disabled, [aria-disabled="true"]) {
+  background-color: var(--surface-soft);
+  background-image: none;
+  color: var(--muted);
+  border-color: var(--store-border-control);
+  opacity: 1;
+}
+.hoe-store-scope :is(.hoe-quantity button, .ht-number-stepper button, .ht-calendar-controls button,
+  .olf-carousel-controls button, .ht-reset-calendar):disabled {
+  background-image: none;
+  color: var(--muted);
+  opacity: 1;
+}
+.hoe-store-scope :is(a, button, input, select, textarea, summary):focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 3px;
+}
+.hoe-store-scope :is(.ht-inquiry, .ht-product-form) :is(button, input, textarea, select, summary):focus-visible,
+.hoe-store-scope .ht-period-option:has(input:focus-visible) {
+  outline: 2px solid var(--focus);
+  outline-offset: 3px;
+}
+
+/* Reading surfaces, photos and semantic alerts never acquire a tint overlay. */
+.hoe-store-scope :is(.prose, .comments, .cart-row, .faq, .olf-faq, .hoe-faq) {
+  background-color: var(--store-surface-reading);
+  background-image: none;
+}
+.hoe-store-scope :is(form.card, .hoe-editorial-detail .detail-copy form, .ht-inquiry, .comments form, .edit-form) {
+  background-color: var(--background);
