diff --git a/src/components/StoreFallbackScope.tsx b/src/components/StoreFallbackScope.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/StoreFallbackScope.tsx
@@ -0,0 +1,11 @@
+"use client";
+
+import { usePathname } from "next/navigation";
+import type { ReactNode } from "react";
+
+/** Root 404s bypass ShopLayout. Keep internal/auth fallbacks outside Store. */
+export function StoreFallbackScope({ className, children }: { className: string; children: ReactNode }) {
+  const pathname = usePathname();
+  const outsideStore = /^\/(?:admin|dang-nhap|xem-thu)(?:\/|$)/.test(pathname ?? "");
+  return outsideStore ? children : <div className={className}>{children}</div>;
+}
diff --git a/src/components/StoreHeading.tsx b/src/components/StoreHeading.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/StoreHeading.tsx
@@ -0,0 +1,16 @@
+import type { ReactNode } from "react";
+
+/** Static, full-width background owner; the existing content measure stays inside. */
+export function StoreHeading({
+  children,
+  containerClassName = "",
+}: {
+  children: ReactNode;
+  containerClassName?: string;
+}) {
+  return (
+    <div className="store-heading-section">
+      <div className={`container ${containerClassName}`.trim()}>{children}</div>
+    </div>
+  );
+}
