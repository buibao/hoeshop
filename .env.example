# live (default) or test. Test content is forbidden on Vercel production.
CONTENT_MODE=live
# sheets (default) or mock. Mock is allowed only locally, with test content.
DATA_ADAPTER=sheets
SHEETS_GATEWAY_URL=
SHEETS_GATEWAY_SECRET=
RATE_LIMIT_SECRET=
SITE_URL=http://localhost:3000
# Set true only after real content, policies and production Sheets are verified.
SHOP_LIVE=false
