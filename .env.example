# Local DB: development/test. Deployment derives preview/production from VERCEL_ENV.
DB_ENV=development
DATABASE_URL=
# Direct (unpooled) URL: migration/seed only. Do not expose to the browser.
DATABASE_URL_UNPOOLED=
DATA_ADAPTER=postgres
# Preview defaults to test. Production must use live; never promote fixtures.
CONTENT_MODE=live
RATE_LIMIT_SECRET=
SITE_URL=http://localhost:3000
SHOP_LIVE=false
# Clerk development for Preview; separate production instance and Google OAuth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs. Email alone does not grant admin access.
ADMIN_CLERK_USER_IDS=
BLOB_READ_WRITE_TOKEN=
