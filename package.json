{
  "name": "hoeshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env CONTENT_MODE=test DATA_ADAPTER=mock next dev",
    "dev:hoa-thoi": "node scripts/local-hoa-thoi.mjs --webpack",
    "dev:e2e": "cross-env CONTENT_MODE=test DATA_ADAPTER=mock NEXT_DIST_DIR=.next-e2e next dev --port 3100",
    "prebuild": "tsx scripts/validate-content.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:dry": "tsx scripts/db/seed.ts --dry-run",
    "db:hoa-thoi:dry": "tsx scripts/db/hoa-thoi.ts",
    "db:hoa-thoi:apply": "tsx scripts/db/hoa-thoi.ts --apply",
    "db:readiness": "tsx scripts/db/readiness.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:uat": "playwright test --config playwright.uat.config.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "gray-matter": "4.0.3",
    "react-markdown": "10.1.0",
    "lucide-react": "1.52.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "@clerk/nextjs": "7.9.10",
    "@vercel/blob": "2.8.0",
    "react-bootstrap": "2.10.10",
    "bootstrap": "5.3.8",
    "motion": "14.0.0",
    "lenis": "1.3.26",
    "@daypicker/react": "10.0.2",
    "date-fns": "4.4.0",
    "sharp": "0.35.5",
    "@next/env": "16.3.8",
    "embla-carousel-react": "8.6.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "@emnapi/core": "1.10.0",
    "@emnapi/wasi-threads": "1.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "tsx": "4.23.15",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.16.0",
    "sass": "1.105.1"
  }
}
