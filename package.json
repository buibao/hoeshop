{
  "name": "hoeshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env CONTENT_MODE=test DATA_ADAPTER=mock next dev",
    "dev:e2e": "cross-env CONTENT_MODE=test DATA_ADAPTER=mock NEXT_DIST_DIR=.next-e2e next dev --port 3100",
    "prebuild": "tsx scripts/validate-content.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "gray-matter": "4.0.3",
    "react-markdown": "10.1.0",
    "lucide-react": "1.52.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "tsx": "4.23.15",
    "cross-env": "10.1.0"
  }
}
